# Server-only Vertex AI env for Netlify Functions (and similar backends).
# Never pass these through --dart-define / Flutter web. The student app
# calls /rag/vertex-* ; credentials stay on the server.
#
# Auth / CORS / SSRF (required at function runtime, not dart-define):
# FIREBASE_PROJECT_ID=mpsc-3f4ef
# FIREBASE_STORAGE_BUCKET=mpsc-3f4ef.firebasestorage.app
# CORS_ALLOWED_ORIGINS=https://your-student-origin,https://your-admin-origin
# RAG_ALLOWED_PDF_HOSTS=
# ADMIN_UIDS=
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1
VERTEX_MODEL=
VERTEX_EMBED_MODEL=gemini-embedding-001
VERTEX_ACCESS_TOKEN=
VERTEX_SERVICE_ACCOUNT_JSON=
GOOGLE_CLOUD_PROJECT=
