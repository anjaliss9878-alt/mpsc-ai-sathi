rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    function isPublished() {
      return resource.data.published != false;
    }

    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /students/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /students/{uid}/progress/{progressId} {
      allow read, write: if isOwner(uid);
    }

    match /students/{uid}/chats/{chatId} {
      allow read, write: if isOwner(uid);
    }

    match /students/{uid}/chats/{chatId}/messages/{messageId} {
      allow read, write: if isOwner(uid);
    }

    match /subjects/{subjectId} {
      allow read: if isAdmin() || (isSignedIn() && isPublished());
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /chapters/{chapterId} {
      allow read: if isAdmin() || (isSignedIn() && isPublished());
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /notes/{noteId} {
      allow read: if isAdmin() || (isSignedIn() && isPublished());
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /mcqs/{mcqId} {
      allow read: if isAdmin() || (isSignedIn() && isPublished());
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /pyqs/{pyqId} {
      allow read: if isAdmin() || (isSignedIn() && isPublished());
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /tests/{testId} {
      allow read: if isAdmin() || (isSignedIn() && isPublished());
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /currentAffairs/{itemId} {
      allow read: if isAdmin() || (isSignedIn() && isPublished());
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /videos/{videoId} {
      allow read: if isAdmin() || (isSignedIn() && isPublished());
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /liveClasses/{classId} {
      allow read: if isAdmin() || (isSignedIn() && isPublished());
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
